<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lightrover_e32_imitation</name>
  <version>0.1.0</version>
  <description>ライトローバーE32 模倣学習サンプル (LiDAR -> 速度指令 / Behavior Cloning)</description>
  <maintainer email="infodesk@vstone.co.jp">Vstone</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>lightrover_e32_bringup</exec_depend>
  <exec_depend>mouse_teleop</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- シミュレータ (il_sim / sim.launch.py) 用 -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>lightrover_e32_description</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
